diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
--- a/crates/gpui/src/window.rs
+++ b/crates/gpui/src/window.rs
@@ -1280,2 +1280,3 @@
     mouse_position: Point<Pixels>,
+    mouse_button_event_sequence: u64,
     mouse_hit_test: HitTest,
@@ -2471,2 +2472,3 @@
             mouse_position,
